{
  "vease_back": {
    "packages_versions": {
      "$id": "vease_back/packages_versions",
      "route": "/packages_versions",
      "methods": [
        "GET"
      ],
      "type": "object",
      "additionalProperties": false,
      "response": {
        "type": "object",
        "properties": {
          "packages_versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "package": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "package",
                "version"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "packages_versions"
        ],
        "additionalProperties": false
      }
    },
    "microservice_version": {
      "$id": "vease_back/microservice_version",
      "route": "/microservice_version",
      "methods": [
        "GET"
      ],
      "type": "object",
      "additionalProperties": false,
      "response": {
        "type": "object",
        "properties": {
          "microservice_version": {
            "type": "string"
          }
        },
        "required": [
          "microservice_version"
        ],
        "additionalProperties": false
      }
    },
    "healthcheck": {
      "$id": "vease_back/healthcheck",
      "route": "/healthcheck",
      "methods": [
        "GET"
      ],
      "type": "object",
      "additionalProperties": false,
      "response": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      }
    }
  }
}